{
  "name": "bigint.bitlength",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picocalc/bigint.bitlength.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "bun --cpu-prof-md --cpu-prof-dir ./bench/profiles bench/index.ts",
    "test": "bun run --sequential build test:bun test:node",
    "test:bun": "bun test",
    "test:node": "node --test",
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@gameroman/config": "0.3.0",
    "@types/bun": "1.4.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsdown": "0.23.3",
    "typescript": "7.0.2"
  }
}
